# Copy to .env and change values. Never commit the real .env.
# API port in development (Vite proxies /api here). In production, PORT is used instead.
API_PORT=4100
# Long random string. Required when NODE_ENV=production.
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5180
# DB_PATH=./data/roomie.db
# UPLOAD_DIR=./uploads

# Email for verification codes. Leave empty in development: codes are printed to the console.
# Example: SMTP_URL=smtps://username:password@smtp.your-provider.com:465
SMTP_URL=
MAIL_FROM=Roomie <no-reply@your-domain.com>
